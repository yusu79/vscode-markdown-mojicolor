{
  "private": true,
  "name": "markdown-mojicolor",
  "displayName": "Markdown MojiColor",
  "description": "Markdownの文字色を変更可能にするVScode拡張機能です｡",
  "version": "1.1.1",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Other"
  ],
  "publisher": "yusu79",
  "author": {
    "name": "yusu79",
    "email": "oss@yusu79.com",
    "url": "https://github.com/yusu79"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yusu79/vscode-markdown-mojicolor"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/yusu79"
  },
  "icon": "images/icon.png",
  "keywords": [
    "markdown",
    "markdown-it",
    "color",
    "text"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "configuration": {
      "title": "Markdown MojiColor",
      "properties": {
        "markdownMojicolor.styles.bold": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "window",
          "markdownDescription": "Markdownプレビューの太字を自動着色する色です。`null`の場合は自動着色しません。"
        },
        "markdownMojicolor.styles.italic": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "window",
          "markdownDescription": "Markdownプレビューの斜体を自動着色する色です。`null`の場合は自動着色しません。"
        },
        "markdownMojicolor.colorFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "追加の色辞書として順番に読み込むJSONファイルの絶対パスです。後のファイルが先の定義と組み込み色を上書きします。"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "25.7.0",
    "@types/vscode": "^1.118.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.3.0",
    "glob": "^13.0.6",
    "markdown-it": "^14.3.1",
    "mocha": "^12.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "js-yaml": "^4.3.1",
    "markdown-it-mojicolor": "^1.3.0"
  }
}
